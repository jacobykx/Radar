<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the exported site.

  It lives in `public/`, so `npm run build:static` copies it into `out/` and the folder
  you hand to IIS is already configured. Nothing here is secret; IIS refuses to serve
  web.config itself.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- IIS will not serve an extension it has no MIME type for, and the instance
           document is the whole application state. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
    </staticContent>
  </system.webServer>

  <!-- The instance is meant to be swapped without a redeploy, so it is never cached.
       Everything else under /_next is content-hashed and cached by default. -->
  <location path="instances">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
