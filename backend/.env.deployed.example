# Template for a DEPLOYED environment (SIT / UAT / PROD).
#
# Not a file to copy into the repository or into an image. Every value below belongs in
# the platform's configuration or secret store; `backend/.env` is git-ignored and exists
# for local development only.
#
# The contrast with .env.example is the point: the two settings that make local
# development convenient are exactly the two that must never ship.

# ── required ───────────────────────────────────────────────────────────────────

# Postgres. The SQLite fallback is not a deployment target: it has no JSONB, no
# concurrent writers and no transactional DDL. Inject the password from the secret
# store — never inline it in a manifest.
IAP_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

# MUST be false. With it on, any unauthenticated caller is granted every role —
# planner, approver and admin — because there is no FRAME Auth Service in front of the
# API to contradict them. It defaults to false; set it explicitly so the intent is
# visible in the environment's configuration.
IAP_AUTH_DEV_MODE=false

# The deployed frontend origin(s), comma-separated. Never "*" — the API accepts
# role-bearing headers, so a permissive origin is an authorisation problem, not just a
# CORS one.
IAP_CORS_ORIGINS=https://<frontend-host>

# ── optional ───────────────────────────────────────────────────────────────────

# The plan year the module serves. Advance it when the planning cycle rolls over.
IAP_PLAN_YEAR=2027

# ── deliberately absent ────────────────────────────────────────────────────────
#
# IAP_DEV_USERNAME / IAP_DEV_AD_GROUPS are read only when IAP_AUTH_DEV_MODE is true.
# Setting them in a deployed environment has no effect and reads as though anonymous
# access were intended — leave them out.
#
# Schema changes are applied by `alembic upgrade head` as an explicit deploy step, not
# by the application at start-up. See the migrate service in docker-compose.yml.
