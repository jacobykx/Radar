# Local development configuration. Copy to `.env` — which is git-ignored — and adjust.
# Never commit a real connection string, credential or token.

# Postgres in every deployed environment; SQLite is the local fallback for machines
# with no database server installed.
#   IAP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/iap
IAP_DATABASE_URL=sqlite+pysqlite:///./iap_local.db

# LOCAL ONLY. With no authentication gateway in front of the API there is no sign-on
# token to decode, so this substitutes a synthetic identity. It must stay false in SIT,
# UAT and PROD — with it on, any unauthenticated caller is granted every role.
IAP_AUTH_DEV_MODE=true
IAP_DEV_USERNAME=local.developer
IAP_DEV_AD_GROUPS=IAP_PLANNER,IAP_APPROVER,IAP_ADMIN

# Origins allowed to call the API. Set per environment; never widen to "*".
IAP_CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

IAP_PLAN_YEAR=2027
