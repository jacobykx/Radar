# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# CI test and coverage reports
junit.xml
reports/
coverage/
coverage.xml

# The generated API client IS committed, deliberately: it keeps the repo type-checkable
# and buildable without a running backend. Regenerate it with `npm run generate:api`
# whenever the API contract changes — never edit it by hand.

# Environment — never commit connection strings or secrets.
# The *.example templates carry placeholders only and are meant to be read.
.env
.env.*
!.env.example
!.env.deployed.example

# OS / editor
.DS_Store
.idea/
*.swp

# Local development database (SQLite fallback)
*.db

# Next.js agent guidance regenerated by `next dev`
frontend/AGENTS.md
frontend/CLAUDE.md

# Also regenerated by Next, and it thrashes: `next dev` writes imports pointing at
# .next/dev/types/, `next build` writes .next/types/, so whichever ran last leaves the
# tree dirty. Both variants are equivalent and Next rewrites the file on every dev and
# build, so tracking it only produces churn. Verified that typecheck, jest and build all
# pass on a checkout without it.
frontend/next-env.d.ts

# The Helios planning module's plan file — local working state, not source.
iap-plan.json
.iap-plan.json.*.tmp
